{
  "name": "Автологин",
  "manifest_version": 3,
  "version": "0.2",
  "minimum_chrome_version": "120",
  "description": "Настройка автовхода",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "Resource/JS/login.js"
      ]
    }
  ],
  "background": {
    "service_worker": "Resource/JS/background.js"
  },
  "options_ui": {
    "page": "options.html"
  }
}
